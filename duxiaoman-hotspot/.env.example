# ============ AIHubMix API（AI 判断与植入策略生成） ============
AIHUBMIX_API_KEY=sk-your-key-here
AIHUBMIX_BASE_URL=https://api.inferera.com/v1

# ============ TikHub API（媒体平台热点 + 达人视频 + 抖音搜索） ============
TIKHUB_TOKEN=your-token-here
# 大陆用户建议 https://api.tikhub.dev，默认 https://api.tikhub.io
# TIKHUB_BASE_URL=https://api.tikhub.io

# ============ 品牌选择（可选） ============
# 决定读哪个 config/<brand>/（飞书表、预筛词表、锚点池、prompt、达人清单）
# 命令行 --brand 优先级高于此变量
# WORKFLOW_BRAND=duxiaoman

# ============ 飞书热点素材表（可选，覆盖品牌配置里的 tables.hotspot） ============
# 默认值来自 config/<brand>/config.json，仅需临时指向别的表时才在此覆盖
# HOTSPOT_BASE_TOKEN=STMrbQgqma35dksI3WsclJlNnlc
# HOTSPOT_TABLE_ID=tblDpxkM7psozqeO

# ============ 模型配置（可选） ============
DEEPSEEK_MODEL=deepseek-v4-pro
DOUBAO_MODEL=doubao-seed-2-1-pro

# ============ 达人清单（可选，默认 config/<brand>/hotspot_creators.json） ============
# CREATORS_FILE=/path/to/hotspot_creators.json
