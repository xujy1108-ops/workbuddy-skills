# AIHubMix API
AIHUBMIX_API_KEY=sk-your-key-here
AIHUBMIX_BASE_URL=https://api.inferera.com/v1

# TikHub API (抖音搜索)
TIKHUB_TOKEN=your-token-here

# 飞书多维表格
BITABLE_BASE_TOKEN=your-base-token
BITABLE_TABLE_ID=your-table-id

# 模型配置（可选）
DEEPSEEK_MODEL=deepseek-v4-pro
DOUBAO_MODEL=qwen3-vl-plus

# 并发数（可选）
WORKFLOW_CONCURRENCY=3

# 搜索配置（可选）
# 排序：0=综合排序（默认，2026-09-16 应用户要求由 1 最多点赞改为 0）/ 1=最多点赞 / 2=最新发布
SEARCH_SORT_TYPE=0
# 每个关键词搜索翻页数（默认 1，即每词约 7-10 条）
SEARCH_PAGES=1
# 最低点赞数门槛（默认 0 不过滤，全部交 AI 相关性判定；2026-09-16 由 2000 改为 0，与综合排序配套）
MIN_DIGG_COUNT=0
