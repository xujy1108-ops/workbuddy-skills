# ===== strategy-review 环境变量 =====
# 复制为 .env（或放到 config/<brand>/.env 做品牌级覆盖）后填写

# AIHubMix 网关（必需）
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://api.inferera.com/v1
DOUBAO_MODEL=doubao-seed-2-1-pro

# 默认品牌（--brand 参数优先级更高）
WORKFLOW_BRAND=duxiaoman

# ===== 表覆盖（可选）=====
# 不填则使用 config/<brand>/config.json 里的默认值
# 度小满（历史变量名）
# TOUTIAO_BASE_TOKEN=
# TOUTIAO_TABLE_ID=
# REVIEW_TABLE_ID=
# 微业贷
# WEIYEDAI_SOURCE_BASE_TOKEN=
# WEIYEDAI_SOURCE_TABLE_ID=
# WEIYEDAI_REVIEW_BASE_TOKEN=
# WEIYEDAI_REVIEW_TABLE_ID=
