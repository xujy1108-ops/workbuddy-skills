# ===== Required =====
ANTHROPIC_API_KEY=sk-xxx
# AiHubMix 或 Anthropic 官方
ANTHROPIC_BASE_URL=https://aihubmix.com

# TikHub 抖音达人数据拉取
TIKHUB_API_TOKEN=your_tikhub_token

# ===== 多模态（听 mp3 分析达人风格）=====
# OpenAI 兼容接口，默认 AiHubMix
MULTIMODAL_API_KEY=sk-xxx
MULTIMODAL_BASE_URL=https://aihubmix.com/v1
MULTIMODAL_MODEL=gemini-2.5-flash

# ===== Optional =====
DEFAULT_MODEL=claude-opus-4-7
MAX_TOKENS=4096

# 代理（如需要）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 音频截取秒数（默认 60 秒，听口吻足够）
INFLUENCER_AUDIO_MAX_SECONDS=60

# Whisper 转写模型（仅无音频时兜底用）
WHISPER_MODEL=small
