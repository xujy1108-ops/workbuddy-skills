# ===== Required =====
ANTHROPIC_API_KEY=sk-xxx
# AiHubMix 或 Anthropic 官方
ANTHROPIC_BASE_URL=https://aihubmix.com

# TikHub 抖音达人数据拉取
TIKHUB_API_TOKEN=your_tikhub_token

# ===== 视频多模态分析（达人风格）=====
# inferera OpenAI 兼容接口；qwen3-vl-plus 与 creative-content-analysis 同网关同模型
# 不填 VIDEO_API_KEY 时回退使用 ANTHROPIC_API_KEY
VIDEO_API_KEY=sk-xxx
VIDEO_BASE_URL=https://api.inferera.com/v1
VIDEO_MODEL=qwen3-vl-plus

# ===== Optional =====
DEFAULT_MODEL=claude-opus-4-7
MAX_TOKENS=8192

# 代理（如需要）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
